{
  "name": "familyos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FamilyOS - Aile takvimi, ev panosu ve kiosk/PWA aile işletim sistemi",
  "scripts": {
    "dev": "vite",
    "dev:sync": "npm run build:server && node scripts/dev-server.mjs",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=server-dist/index.cjs --external:bufferutil --external:utf-8-validate --log-level=warning",
    "start": "node server-dist/index.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json && tsc -p worker/tsconfig.json",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "test": "npm run test:smoke && npm run test:sync && npm run test:crud && npm run test:persist",
    "test:smoke": "node scripts/render-smoke.mjs",
    "test:sync": "npm run build:server && node scripts/sync-smoke-test.mjs",
    "test:persist": "node scripts/persistence-check.mjs",
    "test:meals": "node scripts/meal-smoke.mjs",
    "test:location": "node scripts/location-smoke.mjs",
    "test:crud": "node scripts/crud-smoke.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:db:init": "wrangler d1 execute familyos --remote --file=./worker/schema.sql",
    "cf:db:local": "wrangler d1 execute familyos --local --file=./worker/schema.sql"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-legacy": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "web-push": "^3.6.7",
    "wrangler": "^4.149.0",
    "ws": "^8.18.0",
    "esbuild": "^0.25.12"
  }
}
