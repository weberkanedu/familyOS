# Senkron adresi (derleme zamanı) — çoğu durumda BOŞ bırakın:
#   boş  → uygulamanın kendi adresi (/sync)  (Docker ve Cloudflare'de hazır)
#   off  → yalnızca bu cihaz (senkron yok)
#   geliştirme: ws://localhost:8787/sync  (npm run dev:sync ile)
VITE_SYNC_URL=

# Web Push genel anahtarı: sunucu /push/key ile verir; yalnızca başka bir sunucu kullanıyorsanız gerekir
VITE_VAPID_PUBLIC_KEY=

# Sunucu tarafı (Docker / Dokploy Environment): FAMILY_CODE zorunludur — bkz. README §8
